{
  "name": "@coinbox-co-il/jsqr",
  "version": "1.4.2",
  "type": "module",
  "description": "Fork of jsqr (github.com/cozmo/jsQR) that builds a es-6 target and adds color correction and performance improvements.",
  "repository": "https://github.com/Coinbox-co-il/jsQR",
  "main": "./dist/jsQR.cjs",
  "module": "./dist/jsQR.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "contributors": [
    {
      "name": "Cosmo Wolfe",
      "email": "cosmo.wolfe@gmail.com"
    },
    {
      "name": "Jefff Nelson",
      "email": "gmjefff@gmail.com"
    },
    {
      "name": "danimoh"
    }
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/upng-js": "2.1.5",
    "esbuild": "0.28.2",
    "jest": "30.5.2",
    "typescript": "7.0.2",
    "upng-js": "2.1.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "check": "npm run typecheck && npm run build && npm test",
    "generate-test-data": "node scripts/generate-test-data.mjs",
    "prepack": "npm run build"
  },
  "jest": {
    "testRegex": ".*test\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.ts$": "<rootDir>/scripts/jest-transform.cjs"
    },
    "cacheDirectory": "<rootDir>/node_modules/.cache/jest"
  }
}
